.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*

# ============================================
# PID FILES
# ============================================
*.pid
pids/

# ============================================
# TEMPORARY FILES
# ============================================
tmp/
temp/
*.tmp
*.bak
*.backup
*.old
*.orig
*_backup_*
*_old_*

# Backups
backup_*/
backups/

# ============================================
# REPORTS AND ANALYSIS
# ============================================
reports/
analysis/
*.csv
*.xlsx
*.xls
test_report_*.json
test_scenarios_*.json
