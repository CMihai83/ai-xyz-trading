# Florin Trading System - Git Ignore File
# ===========================================
# Prevents sensitive and temporary files from being committed

# ============================================
# SENSITIVE FILES (NEVER COMMIT THESE!)
# ============================================
.env
.env.local
.env.production
*.key
*.pem
*.p12
credentials.json
secrets.json

# API Keys and Credentials
*_api_key*
*_secret*
*_passphrase*

# ============================================
# STATE AND DATA FILES
# ============================================
# Trading state files
position_state.json
averaging_state.json
continuous_trading_state.json
performance_history.json
trading_state.json

# Position and trade data
position_*.json
trade_*.json
closed_positions*.json
averaging_trigger.json
averaging_state*.json

# Data directories
data/
*.db
*.sqlite
*.sqlite3

# ============================================
# LOG FILES
# ============================================
logs/
*.log
*.log.*
*.log.gz
*.log.old
florin_*.log
aixyz_*.log
trade_audit.log
monitor_*.log
autonomous_sync*.log

# ============================================
# PYTHON
# ============================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# ============================================
# DOCKER
# ============================================
# Docker volumes (local development)
docker-compose.override.yml

