# ==========================================================
# Florin Trading System - Environment Configuration
# ==========================================================
# This is a template file. Copy this to .env and fill in your actual values:
#   cp .env.example .env
#   nano .env  # or vim .env
#
# IMPORTANT: Never commit the .env file to version control!
# ==========================================================

# ----------------------------------------------------------
# BITGET API CREDENTIALS (REQUIRED)
# ----------------------------------------------------------
# Get your API keys from: https://www.bitget.com/api-doc
# Make sure to enable:
#   - Futures Trading
#   - Read Permissions
#   - Trade Permissions
# DO NOT enable withdrawal permissions for security!

FLORIN_BITGET_API_KEY=your_api_key_here
FLORIN_BITGET_API_SECRET=your_api_secret_here
FLORIN_BITGET_API_PASSPHRASE=your_api_passphrase_here

# ----------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------
# PostgreSQL password for the trading database
# Change this to a secure password!
FLORIN_DB_PASSWORD=florin_pass_2025_change_me

# ----------------------------------------------------------
# TRADING CONFIGURATION
# ----------------------------------------------------------
# Initial balance in USD (this is for tracking, not actual deposit)
FLORIN_INITIAL_BALANCE=100.00

# Maximum number of simultaneous positions
FLORIN_MAX_POSITIONS=10

# Use Bitget testnet (true) or live trading (false)
# ALWAYS test on testnet first!
FLORIN_USE_TESTNET=false

# Default leverage multiplier (1-125 depending on symbol)
FLORIN_DEFAULT_LEVERAGE=5

# Maximum allowed leverage
FLORIN_MAX_LEVERAGE=20

# Position size in USD per trade
FLORIN_POSITION_SIZE_USD=10

# ----------------------------------------------------------
# RISK MANAGEMENT (OPTIONAL)
# ----------------------------------------------------------
# Stop loss percentage (e.g., 0.02 = 2%)
FLORIN_STOP_LOSS_PERCENT=0.02

# Take profit percentage (e.g., 0.05 = 5%)
FLORIN_TAKE_PROFIT_PERCENT=0.05

# Maximum daily loss limit in USD
FLORIN_MAX_DAILY_LOSS=50.00

# ----------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
FLORIN_LOG_LEVEL=INFO

# Dashboard web interface port
# Default: 8081 (to avoid conflict with ai_xyz on 8080)
FLORIN_DASHBOARD_PORT=8081

# ----------------------------------------------------------
# NOTIFICATIONS (OPTIONAL)
# ----------------------------------------------------------
# Telegram Bot Token (get from @BotFather)
FLORIN_TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (get from @userinfobot)
FLORIN_TELEGRAM_CHAT_ID=

# Enable/disable notifications
FLORIN_ENABLE_NOTIFICATIONS=false

# ----------------------------------------------------------
# ADVANCED SETTINGS (DO NOT CHANGE UNLESS YOU KNOW WHAT YOU'RE DOING)
# ----------------------------------------------------------
# Redis database number (must be different from ai_xyz which uses db=1)
# This is already set in docker-compose.yml
# REDIS_DB=2

# Market check interval in seconds
FLORIN_MARKET_CHECK_INTERVAL=60

# WebSocket restart delay in seconds
FLORIN_WEBSOCKET_RESTART_DELAY=5

# WebSocket max age in minutes
FLORIN_WEBSOCKET_MAX_AGE_MINUTES=5

# ----------------------------------------------------------
# NOTES
# ----------------------------------------------------------
# 1. This system is completely isolated from ai_xyz
# 2. It uses Redis DB 2 (ai_xyz uses DB 1)
# 3. It has separate PostgreSQL database (florin_trading)
# 4. Logs are stored in /var/log/florin_trading
# 5. State files are in the florin_trading directory
#
# For support or questions, refer to README.md
# ==========================================================
