# Opportunity Discovery Engine Dockerfile
# AI-XYZ Trading System - Multi-factor opportunity scoring

FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir ccxt pandas numpy redis python-dotenv requests

# Copy files
COPY opportunity_discovery_engine.py /app/
COPY .env /app/

# Run the engine
CMD ["python3", "opportunity_discovery_engine.py"]
