# Futures Trading Configuration
TRADING_MODE=futures
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=50
MIN_LEVERAGE=1
MARGIN_MODE=cross  # cross or isolated
POSITION_MODE=hedge  # hedge or one_way

# Risk Management for Futures
MAX_MARGIN_USAGE=0.8  # 80% max margin usage
LIQUIDATION_BUFFER=0.15  # 15% buffer from liquidation
DYNAMIC_LEVERAGE=true
AUTO_DELEVERAGING=true

# Position Sizing for Futures
BASE_POSITION_SIZE_USDT=100  # Base position size in USDT
MAX_POSITION_SIZE_USDT=2000  # Max position size in USDT
MIN_POSITION_SIZE_USDT=10   # Min position size in USDT

# Stop Loss and Take Profit for Futures
FUTURES_STOP_LOSS_PERCENT=0.02  # 2% stop loss
FUTURES_TAKE_PROFIT_PERCENT=0.04  # 4% take profit
TRAILING_STOP_ENABLED=true
TRAILING_STOP_PERCENT=0.01  # 1% trailing stop

# Database Configuration
DATABASE_URL=postgresql://futures_user:secure_futures_password@postgres:5432/futures_trading_db
REDIS_URL=redis://redis:6379/0

# Security Configuration
JWT_SECRET=futures-super-secure-jwt-secret-key-change-this-in-production
API_RATE_LIMIT=2000
CORS_ORIGINS=https://futures.your-domain.com

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOG_LEVEL=info

# Futures-specific Configuration
FUNDING_RATE_THRESHOLD=0.01  # 1% funding rate threshold
MARK_PRICE_DEVIATION_THRESHOLD=0.005  # 0.5% mark price deviation
AUTO_REDUCE_ONLY=true
HEDGE_MODE_ENABLED=true
