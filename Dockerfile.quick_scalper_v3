# Quick Scalper V3.2.0 - Hybrid 1m + OrderBook + Averaging
# AI-XYZ Trading System - High-frequency micro-scalping with averaging

FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir ccxt pandas numpy redis python-dotenv requests

# Copy files
COPY quick_scalper_v3.py /app/
COPY unified_order_router.py /app/
COPY .env /app/

# Run the service
CMD ["python3", "quick_scalper_v3.py"]
